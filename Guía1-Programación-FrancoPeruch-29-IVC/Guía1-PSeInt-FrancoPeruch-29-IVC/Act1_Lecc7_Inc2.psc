// Un algoritmo que determine si la persona es mayor o menor
Algoritmo Act1_Lecc7_Inc2
	Escribir '=====EDAD====='
	// Variables
	Definir e Como Entero
	// Solicitar datos al usuario
	Escribir 'Escribe la edad: '
	Leer e
	// Evaluar si es mayor o menor
	Si e>=18 Entonces
		Escribir 'MAYOR DE EDAD'
	SiNo
		Escribir 'MENOR DE EDAD'
	FinSi
FinAlgoritmo
