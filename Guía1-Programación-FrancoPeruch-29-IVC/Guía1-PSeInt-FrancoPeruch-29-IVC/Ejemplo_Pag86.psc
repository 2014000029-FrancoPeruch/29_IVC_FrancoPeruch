// Un algoritmo que indique si el numero es mayor, igual o menor a cero
Algoritmo Ejemplo_Pag86
	Escribir '=====NÚMERO====='
	// Variables
	Definir n Como Entero
	// Solicitar datos al usuario
	Escribir 'Introduzca un número: '
	Leer n
	// Evaluar el número
	Si (l1<=0 O l2<=0 O l3<=0) Entonces
		Escribir 'El número es menor a cero'
	SiNo
		Escribir 'El número es igual o mayor a cero'
	FinSi
FinAlgoritmo
